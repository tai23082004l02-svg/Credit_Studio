# TEMPLATE ONLY: do not put real keys in this repository or the website folder.
# Fill the private file /workspace/.credit-studio/r2.env instead.
# Replace the empty values below. Keep the actual keys out of chat and GitHub.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT_URL=
R2_BUCKET=credit-studio
# Endpoint format: https://<account-id>.r2.cloudflarestorage.com
# Use the endpoint shown by Cloudflare; do not append the bucket name.
