  "captions": [
    {
      "start": 0,
      "end": 1.6,
      "text": "You finally did it."
    },
    {
      "start": 1.78,
      "end": 2.75,
      "text": "You got the job."
    },
    {
      "start": 3.02,
      "end": 4.1,
      "text": "You got the raise."
    },
    {
      "start": 4.46,
      "end": 6.55,
      "text": "Your salary now has six figures."
    },
    {
      "start": 6.92,
      "end": 9.2,
      "text": "One hundred thousand dollars a year."
    },
    {
      "start": 9.56,
      "end": 13.55,
      "text": "That sounds like the moment money is supposed to stop being stressful."
    },
    {
      "start": 13.96,
      "end": 18.35,
      "text": "But somehow, you’re still checking your bank account before ordering takeout."
    },
    {
      "start": 18.68,
      "end": 23.55,
      "text": "Your car needs new tires, and suddenly you’re doing mental gymnastics."
    },
    {
      "start": 24.1,
      "end": 24.85,
      "text": "And payday?"
    },
    {
      "start": 25.14,
      "end": 28.05,
      "text": "Payday still feels like a rescue mission."
    },
    {
      "start": 28.5,
      "end": 30.1,
      "text": "So what happened?"
    },
    {
      "start": 30.52,
      "end": 34.7,
      "text": "How can someone make a hundred thousand dollars a year and still feel broke?"
