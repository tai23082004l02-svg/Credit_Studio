  "captions": [
    {
      "start": 0,
      "end": 1.9,
      "text": "You finally get a raise."
    },
    {
      "start": 2.5,
      "end": 6.1,
      "text": "An extra three hundred dollars a month lands in your bank account."
    },
    {
      "start": 6.68,
      "end": 8.65,
      "text": "For a moment, life feels easier."
    },
    {
      "start": 9.42,
      "end": 12.1,
      "text": "So you upgrade your phone. Thirty dollars more."
    },
    {
      "start": 12.7,
      "end": 15.8,
      "text": "You join a nicer gym. Fifty dollars more."
    },
    {
      "start": 16.42,
      "end": 19.99,
      "text": "You start ordering delivery more often. Another hundred."
    },
    {
      "start": 20.46,
      "end": 24.65,
      "text": "Then come a few subscriptions, a little shopping, and a more expensive weekend."
    },
    {
      "start": 25.2,
      "end": 28.05,
      "text": "By the end of the month, the raise is gone."
    },
    {
      "start": 29.22,
      "end": 30.85,
      "text": "Each purchase felt small."
    },
    {
      "start": 31.44,
      "end": 35.6,
      "text": "Together, they gave your entire raise a job before you chose one."
    },
    {
      "start": 36.02,
      "end": 38.6,
      "text": "Try this before your next raise arrives."
    },
    {
      "start": 39.16,
      "end": 41.05,
      "text": "Decide how much you want to save."
    },
    {
      "start": 41.52,
      "end": 43.3,
      "text": "Set up an automatic transfer."
    },
    {
      "start": 44.2,
      "end": 46.7,
      "text": "Then choose what you want to enjoy with the rest."
    },
    {
      "start": 47.36,
      "end": 49.15,
      "text": "You worked for that extra money."
    },
    {
      "start": 49.62,
      "end": 53.02,
      "text": "Let some of it buy something you cannot put in a shopping cart:"
    },
    {
      "start": 53.28,
      "end": 55.1,
      "text": "A little more breathing room."
    }
  ],
